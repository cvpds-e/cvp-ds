{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cvp.internal/design-system/component-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "components"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "format": "date" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "classification", "lifecycle", "family", "source", "tags", "accessibility"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "classification": { "enum": ["component", "pattern", "page", "utility"] },
          "lifecycle": { "enum": ["approved", "candidate", "local", "deferred", "deprecated", "internal"] },
          "family": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "pattern": "^src/" },
          "documentation": { "type": "string" },
          "tokenPrefix": { "type": "string", "pattern": "^--cvp-" },
          "replacement": { "type": "string" },
          "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "accessibility": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
