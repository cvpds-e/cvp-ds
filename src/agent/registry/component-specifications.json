            "scope": "internal"
          }
        ]
      },
      "evidence": {
        "examples": [
          "src/app/components/ChoiceCardGroupDocumentation.tsx"
        ],
        "tests": [
          "src/app/components/ChoiceCardGroup.test.tsx"
