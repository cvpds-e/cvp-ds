{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cvp.internal/design-system/pattern-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "patterns"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "lifecycle", "intents", "required", "constraints"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "lifecycle": { "enum": ["approved", "candidate", "local", "deferred", "deprecated", "internal"] },
          "intents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "optional": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "reference": { "type": "string" },
          "constraints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
