{
  "version": "1.2.0",
  "specifications": [
    {
      "assetId": "choice-card-group",
      "status": "complete",
      "owner": "Design System team",
      "markdown": "docs/component-specifications/choice-card-group.md",
      "purpose": "Present a small mutually exclusive set of richly described choices.",
      "useWhen": [
        "A single choice needs descriptive comparison."
      ],
      "doNotUseWhen": [
        "Multiple selection is required.",
        "A compact label-only view switch is sufficient."
      ],
      "api": {
        "importPath": "@cvp/design-system",
        "types": [
          {
            "name": "ChoiceCardOption",
            "definition": "interface ChoiceCardOption { value: string; label: string; description?: string; icon?: React.ReactNode; badge?: React.ReactNode; disabled?: boolean; }"
          },
          {
            "name": "ChoiceCardGroupProps",
            "definition": "interface ChoiceCardGroupProps { label: string; options: ChoiceCardOption[]; value?: string; defaultValue?: string; onChange?: (value: string) => void; helperText?: string; required?: boolean; disabled?: boolean; columns?: 2 | 3; className?: string; }"
          }
        ],
        "props": [
          {
            "name": "label",
            "type": "string",
            "required": true,
            "description": "Visible group label and accessible name."
          },
          {
            "name": "options",
            "type": "ChoiceCardOption[]",
            "required": true,
            "description": "Two to five stable mutually exclusive options; an empty array renders nothing."
          },
          {
            "name": "value",
            "type": "string",
            "required": false,
            "description": "Controlled selection that must match an enabled option value."
          },
          {
            "name": "defaultValue",
            "type": "string",
            "required": false,
            "default": "first enabled option",
            "description": "Initial uncontrolled selection; ignored when value is supplied."
          },
          {
            "name": "onChange",
            "type": "(value: string) => void",
            "required": false,
            "description": "Called after pointer or keyboard selection."
          },
          {
            "name": "helperText",
            "type": "string",
            "required": false,
            "description": "Guidance associated to the radiogroup with aria-describedby."
          },
          {
            "name": "required",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Adds the required marker and aria-required but performs no form validation."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Disables every option and exposes aria-disabled."
          },
          {
            "name": "columns",
            "type": "2 | 3",
            "required": false,
            "default": "2",
            "description": "Desktop grid column count."
          },
          {
            "name": "className",
            "type": "string",
            "required": false,
            "default": "''",
            "description": "Class added to the component root; not a token replacement mechanism."
          }
        ],
        "variants": [
          "columns=2",
          "columns=3"
        ],
        "states": [
          "default",
          "hover",
          "focus-visible",
          "selected",
          "disabled",
          "required"
        ],
        "controlledUsage": [
          "Use value with onChange for controlled state.",
          "Use defaultValue without value for uncontrolled state.",
          "Do not pass value and defaultValue together."
        ]
      },
      "behavior": {
        "selection": [
          "The first enabled option is selected when no controlled value or valid default exists.",
          "Pointer activation selects an enabled option.",
          "Disabled options cannot be selected."
        ],
        "validation": [
          "required adds a marker and aria-required only.",
          "The component does not block submission or expose aria-invalid or an error-message API.",
          "The parent owns business validation for controlled usage."
        ],
        "keyboard": [
          "Arrow keys select adjacent enabled choices and wrap at boundaries.",
          "Home and End select the first and last enabled choices."
        ],
        "responsive": [
          "columns=2 renders two equal desktop columns and columns=3 renders three.",
          "At viewport widths of 600px or less, columns=3 stacks to one column.",
          "At viewport widths of 460px or less, all groups stack to one column.",
          "No canonical breakpoint tokens exist; 600px and 460px are component-local constants."
        ]
      },
      "accessibility": {
        "semantics": [
          "A named radiogroup contains button elements with the radio role."
        ],
        "naming": [
          "aria-labelledby, aria-describedby, and aria-required associate the visible label, helper text, and required state."
        ],
        "focus": [
          "One enabled radio participates in the tab order and exposes a visible focus ring."
        ],
        "manualChecks": [
          "Verify long content, theme contrast, reflow, and product-context target size."
        ]
      },
