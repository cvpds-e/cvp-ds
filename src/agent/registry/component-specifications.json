    {
      "assetId": "multi-select",
      "status": "reference",
      "owner": "Design System team",
      "markdown": "docs/component-specifications/multi-select.md",
      "purpose": "Let people search and choose multiple values from one field with removable pills.",
      "useWhen": [
        "Multiple values may be selected from a set too long for visible checkboxes.",
        "Search or individually removable selected values materially improve the task."
      ],
      "doNotUseWhen": [
        "Exactly one value is allowed.",
        "A short option set can remain visible as checkboxes.",
        "Values perform navigation rather than form selection."
      ],
      "api": {
        "importPath": "@cvp/design-system",
        "types": [
          {
            "name": "MultiSelectOption",
            "definition": "interface MultiSelectOption { value: string; label: string; disabled?: boolean; }"
          },
          {
            "name": "MultiSelectProps",
            "definition": "interface MultiSelectProps { options: MultiSelectOption[]; value?: string[]; defaultValue?: string[]; onChange?: (values: string[]) => void; id?: string; name?: string; label?: string; labelTooltip?: React.ReactNode; description?: string; placeholder?: string; maxSelection?: number; disabled?: boolean; required?: boolean; error?: boolean | string; className?: string; allowCreate?: boolean; onCreateOption?: (newOption: MultiSelectOption) => void; previewState?: 'hover' | 'focus' | 'open' | 'clear-hover'; }"
          }
        ],
        "props": [
          {
            "name": "options",
            "type": "MultiSelectOption[]",
            "required": true,
            "description": "Stable choices with unique string values; duplicate values resolve to the first option."
          },
          {
            "name": "value",
            "type": "string[]",
            "required": false,
            "description": "Controlled selection; do not combine with defaultValue."
          },
          {
            "name": "defaultValue",
            "type": "string[]",
            "required": false,
            "default": "[]",
            "description": "Initial uncontrolled selection."
          },
          {
            "name": "onChange",
            "type": "(values: string[]) => void",
            "required": false,
            "description": "Receives the complete next selection."
          },
          {
            "name": "id",
            "type": "string",
            "required": false,
            "default": "generated ID",
            "description": "Input ID and base for associated element IDs."
          },
          {
            "name": "name",
            "type": "string",
            "required": false,
            "description": "Emits one hidden input per selected value."
          },
          {
            "name": "label",
            "type": "string",
            "required": false,
            "description": "Visible combobox label; otherwise provide an external label targeting id."
          },
          {
            "name": "labelTooltip",
            "type": "React.ReactNode",
            "required": false,
            "description": "Content adjacent to the label; never the only accessible label."
          },
          {
            "name": "description",
            "type": "string",
            "required": false,
            "description": "Support text associated through aria-describedby."
          },
          {
            "name": "placeholder",
            "type": "string",
            "required": false,
            "default": "Select options...",
            "description": "Shown only when no selected pills exist."
          },
          {
            "name": "maxSelection",
            "type": "number",
            "required": false,
            "default": "unlimited",
            "description": "Positive selection limit that disables unselected options and creation when reached."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Disables input, controls, selection, creation, and removal."
          },
          {
            "name": "required",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Applies native required to the search input while selection is empty."
          },
          {
            "name": "error",
            "type": "boolean | string",
            "required": false,
            "default": "false",
            "description": "Sets aria-invalid; a string also renders an associated alert."
          },
          {
            "name": "className",
            "type": "string",
            "required": false,
            "default": "''",
            "description": "Class added to the root; not a token replacement mechanism."
          },
          {
            "name": "allowCreate",
            "type": "boolean",
            "required": false,
            "default": "true",
            "description": "Allows creation for a unique non-empty query while below the limit."
          },
          {
            "name": "onCreateOption",
            "type": "(newOption: MultiSelectOption) => void",
            "required": false,
            "description": "Receives the internally created option."
          },
          {
            "name": "previewState",
            "type": "'hover' | 'focus' | 'open' | 'clear-hover'",
            "required": false,
            "description": "Documentation-only visual fixture control; do not use in product code."
          }
        ],
        "variants": [
          "closed vocabulary",
          "creatable",
          "limited selection"
        ],
        "states": [
          "default",
          "hover",
          "focus",
          "open",
          "populated",
          "disabled",
          "required",
          "invalid",
          "maximum reached",
          "empty results"
        ],
        "controlledUsage": [
          "Use value with onChange for controlled state.",
          "Use defaultValue without value for uncontrolled state.",
          "Do not pass value and defaultValue together.",
          "For persistent controlled creation, update both parent-owned options and value from onCreateOption and onChange."
        ]
      },
      "behavior": {
        "selection": [
          "Enabled options toggle independently and selected values render as removable pills.",
          "Clear all empties the selection; Select all selects enabled filtered options up to maxSelection.",
          "Creation trims the query and uses it as both value and label when no case-insensitive label match exists.",
          "The field grows vertically when selected pills wrap."
        ],
        "validation": [
          "required uses native input constraint validation only while the selection is empty.",
          "error sets aria-invalid and a string error renders an associated alert.",
          "The product owns error timing, failed-submission focus, and domain validation."
        ],
        "keyboard": [
          "Arrow Down moves from the input to the first enabled option.",
          "Arrow keys move through enabled options and wrap; Enter or Space toggles the focused option.",
          "Escape closes the popup and option Escape returns focus to the input.",
          "Enter creates an available query and Backspace on an empty query removes the last value."
        ],
        "responsive": [
          "Selected pills wrap and the field grows without media-query breakpoints.",
          "The fixed-position portal matches field width and flips above when usable space above exceeds space below.",
          "Popup positioning preserves an 8px viewport inset and 4px field gap.",
          "No canonical responsive breakpoint tokens are used."
        ]
      },
      "accessibility": {
        "semantics": [
          "A combobox controls a portaled multi-select listbox whose options expose aria-selected and aria-disabled."
        ],
        "naming": [
          "A visible or external label names the input; description and string error text compose aria-describedby."
        ],
        "focus": [
          "Input, pill removal, clear, toggle, create, bulk action, and enabled options remain keyboard reachable with visible focus."
        ],
        "manualChecks": [
          "Verify selection announcements, portal reading order, translated content, zoom and reflow, touch targets, and light/dark contrast."
        ]
