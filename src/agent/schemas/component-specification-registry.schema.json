{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cvp.internal/design-system/component-specification-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "specifications"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "specifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "status", "owner", "markdown", "purpose", "useWhen", "doNotUseWhen", "api", "behavior", "accessibility", "tokens", "evidence", "limitations"],
        "properties": {
          "assetId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "status": { "enum": ["draft", "reference", "complete"] },
          "owner": { "type": "string", "minLength": 1 },
          "markdown": { "type": "string", "pattern": "^docs/component-specifications/.+\\.md$" },
          "purpose": { "type": "string", "minLength": 1 },
          "useWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "doNotUseWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "api": { "type": "object", "required": ["props", "variants", "states"], "properties": { "props": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "variants": { "type": "array", "items": { "type": "string" } }, "states": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
          "behavior": { "type": "object", "required": ["keyboard", "responsive"], "properties": { "keyboard": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "responsive": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
          "accessibility": { "type": "object", "required": ["semantics", "naming", "focus", "manualChecks"], "properties": { "semantics": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "naming": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "focus": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "manualChecks": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
          "tokens": { "type": "object", "required": ["prefix", "themes"], "properties": { "prefix": { "type": "string", "pattern": "^--cvp-" }, "themes": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
          "evidence": { "type": "object", "required": ["examples", "tests", "visual"], "properties": { "examples": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "visual": { "type": "string", "minLength": 1 } } },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
